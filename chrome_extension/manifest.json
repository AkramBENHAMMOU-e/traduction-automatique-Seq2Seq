{
    "manifest_version": 3,
    "name": "Seq2Seq AI Translator",
    "version": "1.1",
    "description": "Translate English to French using your custom Deep Learning model.",
    "action": {
        "default_popup": "popup.html",
        "default_title": "AI Translate"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "content.css"
            ]
        }
    ],
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "http://localhost:5000/*"
    ]
}